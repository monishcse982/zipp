meta {
  name: List links
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/links?limit=100&offset=0
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("signed-in owner can list the created link", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items.some((item) => item.short_code === bru.getVar("e2eCode"))).to.equal(true);
  });
}
